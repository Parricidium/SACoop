// SACoop.exe : icone, manifeste (styles Windows, PPP), informations de version
1 ICON "sacoop.ico"
1 24 "launcher.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "SACoop"
      VALUE "FileDescription", "SACoop - lanceur"
      VALUE "FileVersion", "1.0"
      VALUE "InternalName", "SACoop"
      VALUE "OriginalFilename", "SACoop.exe"
      VALUE "ProductName", "SACoop"
      VALUE "ProductVersion", "1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
